                    //pFrame = bgFrame;
                    MF_RECT rec = new MF_RECT();
                    rec.dblPosX = 0;
                    rec.dblPosY = 0;
                    rec.dblWidth = 720;
                    rec.dblHeight = 576;
                    //1064,450,1854,1018
