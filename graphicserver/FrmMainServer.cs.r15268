        internal void releaseComObj(object comObj)
        {
            if (comObj != null)
            {
                try
                {
                    Marshal.ReleaseComObject(comObj);
                    comObj = null;
                }
                catch (Exception ex)
                {
                    objlog.WriteError("releaseComObj", "Error in Releasing com object " + ex.ToString(), ChannelName);
                }
            }
        }







