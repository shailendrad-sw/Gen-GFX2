        private void DEActivateSquzFlag()
        {
            try
            {
                if (FlgSqzOn == true && KeyingMode == true)
                {
                    FlgSqzOn = false;
                    avprops.vidProps.fccType = eMFCC.eMFCC_ARGB32;
                }
            }
            catch (Exception ex)
